---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGroup from '../components/SkillGroup.astro';
import ChallengeCard from '../components/ChallengeCard.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/components.css';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => data.featured);
const challenges = await getCollection('challenges', ({ data }) => data.featured);

const skills = {
  backend: ['Java', 'Spring Boot', 'Spring Security', 'JPA / Hibernate', 'REST APIs', 'WebSockets'],
  databases: ['MySQL', 'PostgreSQL', 'MongoDB'],
  cloud: ['AWS', 'Docker', 'GitHub Actions', 'CI/CD', 'CloudFront', 'S3'],
  frontend: ['React', 'JavaScript', 'HTML', 'CSS'],
  tools: ['Git', 'GitHub', 'OpenAPI', 'IntelliJ IDEA', 'VS Code'],
};
---

<BaseLayout
  title="Esteban Pinto | Backend Developer"
  description="Portfolio de Esteban Pinto, Backend Developer especializado en Java, Spring Boot y desarrollo de sistemas de software."
>
  <Header />

  <main>
    <Hero />
    <About />
    <Experience />

    <section class="section projects" id="projects">
      <div class="container">
        <h2 class="section-title fade-in">Selected Projects</h2>
        <div class="projects-grid">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              category={project.data.category}
              description={project.data.description}
              technologies={project.data.technologies}
              slug={project.id.replace(/\.md$/, '')}
              featured={project.data.featured}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section skills" id="skills">
      <div class="container">
        <h2 class="section-title fade-in">Technical Skills</h2>
        <div class="skills-grid">
          <SkillGroup title="Backend" skills={skills.backend} />
          <SkillGroup title="Databases" skills={skills.databases} />
          <SkillGroup title="Cloud & DevOps" skills={skills.cloud} />
          <SkillGroup title="Frontend" skills={skills.frontend} />
          <SkillGroup title="Tools" skills={skills.tools} />
        </div>
      </div>
    </section>

    <section class="section challenges" id="challenges">
      <div class="container">
        <h2 class="section-title fade-in">Technical Challenges</h2>
        <div class="challenges-grid">
          {challenges.map((challenge) => (
            <ChallengeCard
              title={challenge.data.title}
              description={challenge.data.description}
              technologies={challenge.data.technologies}
              slug={challenge.id.replace(/\.md$/, '')}
            />
          ))}
        </div>
      </div>
    </section>

    <Contact />
  </main>

  <Footer />
</BaseLayout>

<style>
  .projects-grid,
  .challenges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .projects-grid,
    .challenges-grid {
      grid-template-columns: 1fr;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
