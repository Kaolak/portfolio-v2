---
import { modules } from '../data/experienceModules.js';
import { resolveLocale, useI18n } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const { t, tList } = useI18n(locale);
const responsibilities = tList('experience.responsibilities');

function renderTags(tech) {
  return tech.map((tag) => `<span class="tag">${tag}</span>`).join('');
}
---

<section class="section experience" id="experience">
  <div class="container">
    <h2 class="section-title fade-in">{t('experience.title')}</h2>

    <div class="timeline">
      <div class="timeline-item fade-in">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-header">
            <h3 class="timeline-company">{t('experience.company')}</h3>
            <span class="timeline-date">{t('experience.date')}</span>
          </div>
          <p class="timeline-role">{t('experience.role')}</p>
          <p class="timeline-description">
            {t('experience.description')}
          </p>

          <div class="timeline-details">
            <h4 class="timeline-subtitle">{t('experience.responsibilitiesTitle')}</h4>
            <ul class="timeline-list">
              {responsibilities.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div class="modules-section">
            <h4 class="timeline-subtitle">{t('experience.modulesTitle')}</h4>
            <div class="modules-grid" role="list">
              {modules.map((module) => (
                <article
                  class="module-card"
                  role="listitem"
                  tabindex="0"
                  data-module-id={module.id}
                  aria-describedby={`tooltip-${module.id}`}
                >
                  <div class="module-card-inner">
                    <h5 class="module-title">{module[locale].title}</h5>
                    <p class="module-short">{module[locale].shortDesc}</p>
                  </div>

                  <div
                    id={`tooltip-${module.id}`}
                    class="module-tooltip"
                    role="tooltip"
                    aria-hidden="true"
                  >
                    <div class="tooltip-content">
                      <p class="tooltip-description">{module[locale].description}</p>
                      <div class="tooltip-tech" set:html={renderTags(module.tech)} />
                    </div>
                    <div class="tooltip-arrow" aria-hidden="true"></div>
                  </div>

                  <div class="module-expanded" aria-hidden="true" hidden>
                    <p class="expanded-description">{module[locale].description}</p>
                    <div class="expanded-tech" set:html={renderTags(module.tech)} />
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="timeline-tech">
            <span class="tag">Java</span>
            <span class="tag">Spring Boot</span>
            <span class="tag">React</span>
            <span class="tag">AWS</span>
            <span class="tag">Docker</span>
            <span class="tag">Git</span>
            <span class="tag">MySQL</span>
            <span class="tag">Vercel</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -2rem;
    top: 0.35rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--background);
    z-index: 1;
  }

  .timeline-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .timeline-company {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .timeline-date {
    font-size: 0.82rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .timeline-role {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .timeline-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .timeline-subtitle {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .timeline-list {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .timeline-list li {
    color: var(--text-secondary);
    font-size: 0.9rem;
    padding-left: 1rem;
    position: relative;
  }

  .timeline-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  .timeline-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 1rem;
  }

  /* Modules section */
  .modules-section {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
    position: relative;
    z-index: 1;
  }

  .module-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    cursor: default;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease, z-index 0s;
    z-index: 1;
  }

  .module-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    z-index: 20;
  }

  .module-card:focus {
    z-index: 20;
  }

  .module-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .module-card-inner {
    position: relative;
    z-index: 1;
  }

  .module-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .module-short {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Tooltip (desktop hover) */
  .module-tooltip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    width: max-content;
    max-width: 320px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 10;
    box-shadow: var(--shadow);
    transition: opacity 0.15s ease, visibility 0.15s ease, transform 0.15s ease;
  }

  .module-card:hover .module-tooltip,
  .module-card:focus .module-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(-4px);
    pointer-events: auto;
  }

  .module-card:focus .module-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(-4px);
  }

  .tooltip-content {
    padding: 0.875rem;
  }

  .tooltip-description {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .tooltip-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tooltip-arrow {
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    pointer-events: none;
  }

  /* Mobile expanded state */
  .module-expanded {
    display: none;
    padding-top: 0.75rem;
    margin-top: 0.75rem;
    border-top: 1px solid var(--border);
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .module-card[data-expanded] .module-expanded {
    display: block;
  }

  .expanded-description {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .expanded-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  @media (max-width: 768px) {
    .modules-grid {
      grid-template-columns: 1fr;
    }

    .module-tooltip {
      display: none;
    }

    .module-card:hover {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .module-card,
    .module-tooltip,
    .module-expanded {
      transition: none;
      animation: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const cards = document.querySelectorAll('.module-card');

    cards.forEach(function (card) {
      const expanded = card.querySelector('.module-expanded');
      if (!expanded) return;

      function toggleExpanded() {
        const isExpanded = card.hasAttribute('data-expanded');
        if (isExpanded) {
          card.removeAttribute('data-expanded');
          expanded.setAttribute('hidden', '');
          expanded.setAttribute('aria-hidden', 'true');
        } else {
          card.setAttribute('data-expanded', '');
          expanded.removeAttribute('hidden');
          expanded.setAttribute('aria-hidden', 'false');
        }
      }

      card.addEventListener('click', function (e) {
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          return;
        }
        if (e.target.closest('.module-tooltip')) return;
        toggleExpanded();
      });

      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleExpanded();
        }
      });
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.module-card')) {
        cards.forEach(function (card) {
          if (card.hasAttribute('data-expanded')) {
            card.removeAttribute('data-expanded');
            const expanded = card.querySelector('.module-expanded');
            if (expanded) {
              expanded.setAttribute('hidden', '');
              expanded.setAttribute('aria-hidden', 'true');
            }
          }
        });
      }
    });
  });
</script>