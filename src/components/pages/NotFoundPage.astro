---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { localePath, resolveLocale, useI18n } from '../../i18n';
import '../../styles/global.css';
import '../../styles/components.css';

const locale = resolveLocale(Astro.currentLocale);
const { t } = useI18n(locale);
---

<Header />

<main class="not-found">
  <div class="container">
    <p class="not-found-code fade-in">404</p>
    <h1 class="not-found-title fade-in">{t('notFound.title')}</h1>
    <p class="not-found-message fade-in">{t('notFound.message')}</p>
    <a href={localePath(locale)} class="btn btn-primary fade-in">{t('notFound.backHome')}</a>
  </div>
</main>

<Footer />

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding-top: 6rem;
    padding-bottom: 4rem;
    text-align: center;
  }

  .not-found .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .not-found-code {
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
  }

  .not-found-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .not-found-message {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 420px;
    margin-bottom: 1rem;
  }
</style>
