<section class="hero" id="hero">
  <div class="container">
    <div class="hero-content fade-in">
      <div class="hero-tags">
        <span class="tag">Java</span>
        <span class="tag">Spring Boot</span>
        <span class="tag">Backend</span>
        <span class="tag">Cloud</span>
      </div>

      <h1 class="hero-name">Esteban Pinto</h1>
      <p class="hero-title">Backend Developer</p>
      <p class="hero-description">
        Construyo sistemas y APIs orientados a resolver problemas reales,
        con especial interés en Java, Spring Boot y desarrollo de software empresarial.
      </p>

      <div class="hero-actions">
        <a href="/#projects" class="btn btn-primary">View Projects</a>
        <a href="/#contact" class="btn btn-secondary">Contact Me</a>
      </div>

      <div class="hero-social">
        <a href="https://github.com/Kaolak" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
