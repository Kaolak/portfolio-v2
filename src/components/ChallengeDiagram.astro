---

<div class="diagram-container fade-in" aria-label={`Diagram for ${type}`}>
  <Fragment set:html={diagrams[type]} />
</div>

<style>
  .diagram-container {
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow-x: auto;
    display: flex;
    justify-content: center;
  }

  .diagram-svg {
    width: 100%;
    max-width: 440px;
    height: auto;
    color: var(--text-primary);
  }

  @media (max-width: 480px) {
    .diagram-container {
      padding: 1rem;
    }
  }
</style>
