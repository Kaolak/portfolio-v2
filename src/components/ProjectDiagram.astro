---
import { resolveLocale, useI18n } from '../i18n';
import { localizeDiagram } from '../i18n/diagrams';

interface Props {
  type: 'inventory-sales-architecture';
}

const { type } = Astro.props;
const { locale, t } = useI18n(resolveLocale(Astro.currentLocale));

const diagrams: Record<string, string> = {
  'inventory-sales-architecture': `
    <svg viewBox="-75 -110 965 740" fill="none" xmlns="http://www.w3.org/2000/svg" class="diagram-svg">
      <g transform="translate(-200, 0) translate(450, 260) scale(1.5) translate(-450, -260)">
      <!-- ============================================================
           CONTAINERS
           ============================================================ -->

      <!-- Spring Boot API Container -->
      <rect x="240" y="20" width="400" height="480" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="8,6" rx="4"/>
      <text x="440" y="36" text-anchor="middle" fill="currentColor" font-size="11" font-family="JetBrains Mono, monospace" font-weight="bold">Spring Boot API</text>

      <!-- Infrastructure Container -->
      <rect x="670" y="20" width="200" height="480" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="8,6" rx="4"/>
      <text x="770" y="36" text-anchor="middle" fill="currentColor" font-size="11" font-family="JetBrains Mono, monospace" font-weight="bold">Infrastructure</text>

      <!-- ============================================================
           NODES - Spring Boot API (Layered)
           ============================================================ -->

      <!-- Presentation Layer -->
      <rect x="260" y="50" width="360" height="70" fill="none" stroke="var(--accent)" stroke-width="1" stroke-dasharray="4,4" rx="4"/>
      <text x="440" y="60" text-anchor="middle" fill="var(--accent)" font-size="9" font-family="JetBrains Mono, monospace" font-weight="bold">Presentation Layer</text>

      <rect x="325" y="65" width="230" height="40" rx="6" stroke="var(--accent)" stroke-width="1.5" fill="var(--accent-muted)"/>
      <text x="440" y="85" text-anchor="middle" fill="var(--accent)" font-size="9" font-family="JetBrains Mono, monospace">Controllers</text>
      <text x="440" y="95" text-anchor="middle" fill="var(--accent)" font-size="7" font-family="JetBrains Mono, monospace">REST endpoints • DTO validation • @PreAuthorize</text>

      <!-- Service Layer -->
      <rect x="260" y="135" width="360" height="145" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4,4" rx="4"/>
      <text x="440" y="145" text-anchor="middle" fill="currentColor" font-size="9" font-family="JetBrains Mono, monospace" font-weight="bold">Service Layer</text>

      <!-- Module Services -->
      <rect x="280" y="155" width="100" height="55" rx="6" stroke="currentColor" stroke-width="1.5"/>
      <text x="330" y="172" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">User Service</text>
      <text x="330" y="183" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">Auth • Roles • Permissions</text>

      <rect x="390" y="155" width="100" height="55" rx="6" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="172" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">Inventory Svc</text>
      <text x="440" y="183" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">Items • Categories • Suppliers</text>

      <rect x="500" y="155" width="100" height="55" rx="6" stroke="currentColor" stroke-width="1.5"/>
      <text x="550" y="172" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">Sales Svc</text>
      <text x="550" y="183" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">Sales • Payments • Generic Items</text>

      <rect x="280" y="220" width="100" height="55" rx="6" stroke="currentColor" stroke-width="1.5"/>
      <text x="330" y="237" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">Works Svc</text>
      <text x="330" y="248" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">Repairs • Work Types • Items</text>

      <rect x="390" y="220" width="100" height="55" rx="6" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="237" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">Movements Svc</text>
      <text x="440" y="248" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">Financial • Balances</text>

      <rect x="500" y="220" width="100" height="55" rx="6" stroke="currentColor" stroke-width="1.5"/>
      <text x="550" y="237" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">Report Svc</text>
      <text x="550" y="248" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">Native SQL • Recursive CTEs</text>

      <!-- Repository Layer -->
      <rect x="260" y="290" width="360" height="70" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4,4" rx="4"/>
      <text x="440" y="300" text-anchor="middle" fill="currentColor" font-size="9" font-family="JetBrains Mono, monospace" font-weight="bold">Repository Layer</text>

      <rect x="280" y="310" width="150" height="35" rx="5" stroke="currentColor" stroke-width="1.5"/>
      <text x="355" y="330" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">JpaRepository</text>
      <text x="355" y="338" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">JPA + Custom Native Queries</text>

      <rect x="450" y="310" width="150" height="35" rx="5" stroke="currentColor" stroke-width="1.5"/>
      <text x="525" y="330" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">Custom Repos</text>
      <text x="525" y="338" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">ReportRepositoryImpl • Native SQL</text>

      <!-- Domain Layer -->
      <rect x="260" y="375" width="360" height="90" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4,4" rx="4"/>
      <text x="440" y="385" text-anchor="middle" fill="currentColor" font-size="9" font-family="JetBrains Mono, monospace" font-weight="bold">Domain Layer</text>

      <rect x="280" y="395" width="140" height="55" rx="6" stroke="currentColor" stroke-width="1.5"/>
      <text x="350" y="412" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">Entities</text>
      <text x="350" y="422" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">JPA • Auditable • Enums</text>

      <rect x="440" y="395" width="140" height="55" rx="6" stroke="currentColor" stroke-width="1.5"/>
      <text x="510" y="412" text-anchor="middle" fill="currentColor" font-size="8" font-family="JetBrains Mono, monospace">Value Objects</text>
      <text x="510" y="422" text-anchor="middle" fill="currentColor" font-size="7" font-family="JetBrains Mono, monospace">DTOs • Projections • Enums</text>

      <!-- ============================================================
           NODES - Infrastructure
           ============================================================ -->

      <!-- Database -->
      <rect x="690" y="50" width="160" height="60" rx="6" stroke="var(--accent)" stroke-width="1.5" fill="var(--accent-muted)"/>
      <text x="770" y="75" text-anchor="middle" fill="var(--accent)" font-size="10" font-family="JetBrains Mono, monospace" font-weight="bold">MySQL 8+</text>
      <text x="770" y="88" text-anchor="middle" fill="var(--accent)" font-size="7" font-family="JetBrains Mono, monospace">JPA/Hibernate • Flyway</text>

      <!-- Storage -->
      <rect x="690" y="130" width="160" height="60" rx="6" stroke="var(--accent)" stroke-width="1.5" fill="var(--accent-muted)"/>
      <text x="770" y="155" text-anchor="middle" fill="var(--accent)" font-size="10" font-family="JetBrains Mono, monospace" font-weight="bold">MinIO / S3</text>
      <text x="770" y="168" text-anchor="middle" fill="var(--accent)" font-size="7" font-family="JetBrains Mono, monospace">Presigned URLs • Images</text>

      <!-- Email -->
      <rect x="690" y="210" width="160" height="60" rx="6" stroke="var(--accent)" stroke-width="1.5" fill="var(--accent-muted)"/>
      <text x="770" y="235" text-anchor="middle" fill="var(--accent)" font-size="10" font-family="JetBrains Mono, monospace" font-weight="bold">Mailgun</text>
      <text x="770" y="248" text-anchor="middle" fill="var(--accent)" font-size="7" font-family="JetBrains Mono, monospace">Transactional Email</text>

      <!-- Actuator/Monitoring -->
      <rect x="690" y="290" width="160" height="60" rx="6" stroke="var(--accent)" stroke-width="1.5" fill="var(--accent-muted)"/>
      <text x="770" y="315" text-anchor="middle" fill="var(--accent)" font-size="10" font-family="JetBrains Mono, monospace" font-weight="bold">Actuator</text>
      <text x="770" y="328" text-anchor="middle" fill="var(--accent)" font-size="7" font-family="JetBrains Mono, monospace">Health • Metrics • Basic Auth</text>

      <!-- Scheduler -->
      <rect x="690" y="370" width="160" height="60" rx="6" stroke="var(--accent)" stroke-width="1.5" fill="var(--accent-muted)"/>
      <text x="770" y="395" text-anchor="middle" fill="var(--accent)" font-size="10" font-family="JetBrains Mono, monospace" font-weight="bold">Scheduler</text>
      <text x="770" y="408" text-anchor="middle" fill="var(--accent)" font-size="7" font-family="JetBrains Mono, monospace">Image Cleanup (2 AM)</text>

      <!-- ============================================================
           CONNECTORS
           ============================================================ -->

      <!-- Controllers -> Service Layer -->
      <polyline points="440,105 440,135" stroke="var(--accent)" stroke-width="1.5" fill="none" stroke-dasharray="3,2"/>
      <polygon points="440,135 436,127 444,127" fill="var(--accent)"/>

      <!-- Service Layer -> Repository -->
      <polyline points="440,279 440,290" stroke="currentColor" stroke-width="1.5" fill="none"/>
      <polygon points="440,290 436,282 444,282" fill="currentColor"/>

      <!-- Repository -> Domain -->
      <polyline points="440,360 440,375" stroke="currentColor" stroke-width="1.5" fill="none"/>
      <polygon points="440,375 436,367 444,367" fill="currentColor"/>

      <!-- API -> Infrastructure (bidirectional) -->
      <polyline points="640,150 670,150" stroke="var(--accent)" stroke-width="1.5" fill="none" stroke-dasharray="3,2"/>
      <polygon points="670,150 662,144 662,156" fill="var(--accent)"/>

      <!-- Infrastructure -> API (bidirectional) -->
      <polyline points="670,350 640,350" stroke="var(--accent)" stroke-width="1.5" fill="none" stroke-dasharray="3,2"/>
      <polygon points="640,350 648,344 648,356" fill="var(--accent)"/>
      </g>
    </svg>`,
};
---

<div class="diagram-container fade-in" aria-label={`${t('a11y.diagram')} ${type}`}>
  <Fragment set:html={localizeDiagram(diagrams[type], locale)} />
</div>

<style>
  .diagram-container {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow-x: auto;
    display: flex;
    justify-content: center;
  }

  .diagram-svg {
    width: 100%;
    max-width: 720px;
    height: auto;
    color: var(--text-primary);
  }

  @media (max-width: 480px) {
    .diagram-container {
      padding: 1rem;
    }
  }
</style>